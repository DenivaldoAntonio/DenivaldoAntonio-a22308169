nidades": []}}, {"model": "portfolio.docente", "pk": 78, "fields": {"nome": "Tomaz Saraiva", "email": "", "pagina_lusofona": "", "unidades": []}}, {"model": "portfolio.docente", "pk": 79, "fields": {"nome": "Zuil Pirola", "email": "", "pagina_lusofona": "", "unidades": []}}, {"model": "portfolio.tecnologia", "pk": 1, "fields": {"nome": "Python", "descricao": "Linguagem de programação utilizada em desenvolvimento web, automação e análise de dados.", "website": "https://www.python.org", "nivel_interesse": 5}}, {"model": "portfolio.tecnologia", "pk": 2, "fields": {"nome": "Django", "descricao": "Framework web em Python que permite desenvolver aplicações web de forma rápida e organizada, utilizando o padrão MTV (Model Template View).", "website": "https://www.djangoproject.com", "nivel_interesse": 5}}, {"model": "portfolio.tecnologia", "pk": 3, "fields": {"nome": "SQL", "descricao": "Linguagem utilizada para criar, consultar e gerir bases de dados relacionais através de comandos como SELECT, INSERT, UPDATE e DELETE.", "website": "https://www.mysql.com/", "nivel_interesse": 5}}, {"model": "portfolio.tecnologia", "pk": 4, "fields": {"nome": "HTML", "descricao": "Linguagem de marcação utilizada para estruturar páginas web, definindo elementos como títulos, parágrafos, imagens e links.", "website": "https://developer.mozilla.org/pt-BR/docs/Web/HTML", "nivel_interesse": 4}}, {"model": "portfolio.tecnologia", "pk": 5, "fields": {"nome": "Java", "descricao": "Linguagem de programação orientada a objetos utilizada no desenvolvimento de aplicações empresariais, sistemas e aplicações Android.", "website": "https://www.java.com", "nivel_interesse": 5}}, {"model": "portfolio.tecnologia", "pk": 6, "fields": {"nome": "Kotlin", "descricao": "Linguagem moderna baseada na JVM utilizada no desenvolvimento de aplicações Android e programação orientada a objetos.", "website": "https://kotlinlang.org", "nivel_interesse": 3}}, {"model": "portfolio.projeto", "pk": 2, "fields": {"titulo": "Portfolio Académico em Django", "descricao": "Projeto de desenvolvimento de um site de portfólio académico utilizando Django. O objetivo é organizar informação sobre licenciatura, unidades curriculares, docentes, projetos realizados, tecnologias utilizadas e competências adquiridas.", "conceitos": "Modelação de dados, Django ORM, relações ManyToMany, integração de API, organização de portfólio académico.", "github": "https://github.com/DenivaldoAntonio/DenivaldoAntonio-a22308169", "data": "2026-04-11", "unidade": 55, "tecnologias": [2]}}, {"model": "portfolio.competencia", "pk": 1, "fields": {"nome": "Programação", "descricao": "Capacidade de desenvolver algoritmos e aplicações utilizando linguagens de programação como Python, Java e Kotlin.", "nivel": 4, "tecnologias": [1, 2, 3, 4, 5, 6], "projetos": []}}, {"model": "portfolio.competencia", "pk": 2, "fields": {"nome": "Bases de Dados", "descricao": "Capacidade de criar e consultar bases de dados utilizando SQL.", "nivel": 4, "tecnologias": [3], "projetos": []}}, {"model": "portfolio.makingof", "pk": 1, "fields": {"titulo": "Making Of – Modelação da Base de Dados", "descricao": "A modelação da base de dados começou com a criação de um DER para identificar as entidades principais do portfólio académico, como Licenciatura, Unidade Curricular, Docente, Projeto e Tecnologia. Posteriormente foram adicionadas entidades como Competencia, Formacao, TFC, SobreMim e MakingOf para complementar o modelo.\r\n\r\nForam definidas relações entre as entidades para evitar duplicação de dados, como a relação ManyToMany entre Docente e Unidade Curricular e entre Projeto e Tecnologia.\r\n\r\nFoi também utilizada a API da Universidade Lusófona para importar automaticamente as unidades curriculares, tornando o processo mais eficiente.\r\n\r\nO modelo final permite organizar de forma estruturada o percurso académico, projetos e tecnologias utilizadas.", "data": "2026-04-11", "projeto": 2}}, {"model": "portfolio.sobremim", "pk": 1, "fields": {"nome": "Denivaldo António", "biografia": "Estudante de Engenharia Informática interessado em desenvolvimento de software, web e tecnologia. Procuro evoluir continuamente as minhas competências técnicas através de projetos académicos e pessoais. Tenho interesse em programação, inovação e criação de soluções que simplifiquem problemas do dia a dia.", "email": "denivaldomarcio0@gmail.com", "linkedin": "https://www.linkedin.com/in/denivaldo-antonio/", "github": "https://github.com/DenivaldoAntonio", "objetivo_profissional": "Pretendo desenvolver a minha carreira na área de Tecnologia, com interesse especial em Segurança Informática e Ciência de Dados.\r\nSão áreas que me motivam pela sua importância na proteção de informação e na extração de conhecimento a partir de dados.\r\nO meu objetivo é continuar a aprofundar competências técnicas e explorar oportunidades que me permitam contribuir para soluções inovadoras, seguras e orientadas por dados."}}]
